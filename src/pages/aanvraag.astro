---
import Base from '../layouts/Base.astro';
import { PAKKETTEN, SITE, euro } from '../data/site';
---
<Base
  title="Aanvraag doen — CoPortaal"
  description="Vraag uw eigen CoPortaal-omgeving aan. Binnen één werkdag klaar, inclusief import van uw klanten. Geen betaalgegevens nodig."
  pad="/aanvraag"
>
  <section class="container-x grid gap-12 py-16 lg:grid-cols-[3fr_2fr]">
    <div>
      <p class="eyebrow">Aanvraag</p>
      <h1 class="mt-3 text-4xl font-bold tracking-tight text-navy-900">Uw eigen omgeving, binnen één werkdag</h1>
      <p class="mt-4 text-ink-600">Vul het formulier in. Wij nemen dezelfde of de volgende werkdag contact op, richten uw omgeving in en importeren uw klanten. U betaalt pas als het portaal draait.</p>

      <!-- Verzending: naar de aanvraag-functie van CoPortaal Beheer; valt terug op mailto. -->
      <form id="aanvraag" class="mt-8 grid gap-5" method="post" action="/api/aanvraag">
        <div class="grid gap-5 sm:grid-cols-2">
          <label class="grid gap-1 text-sm font-medium">Kantoornaam<input name="kantoor" required class="rounded-xl border border-navy-100 px-3 py-2.5" /></label>
          <label class="grid gap-1 text-sm font-medium">KvK-nummer<input name="kvk" inputmode="numeric" class="rounded-xl border border-navy-100 px-3 py-2.5" /></label>
          <label class="grid gap-1 text-sm font-medium">Contactpersoon<input name="naam" required class="rounded-xl border border-navy-100 px-3 py-2.5" /></label>
          <label class="grid gap-1 text-sm font-medium">E-mailadres<input name="email" type="email" required class="rounded-xl border border-navy-100 px-3 py-2.5" /></label>
          <label class="grid gap-1 text-sm font-medium">Telefoon<input name="telefoon" type="tel" class="rounded-xl border border-navy-100 px-3 py-2.5" /></label>
          <label class="grid gap-1 text-sm font-medium">Aantal medewerkers<input name="gebruikers" type="number" min="1" value="3" class="rounded-xl border border-navy-100 px-3 py-2.5" /></label>
        </div>
        <fieldset class="grid gap-2">
          <legend class="text-sm font-medium">Pakket</legend>
          {PAKKETTEN.map(p => (
            <label class="flex items-center gap-3 rounded-xl border border-navy-100 p-3 text-sm has-[:checked]:border-navy-600 has-[:checked]:bg-navy-50/60"><input type="radio" name="pakket_keuze" value={p.slug} checked={p.aanbevolen} class="pak h-4 w-4 accent-navy-800" /> {p.naam} <span class="text-ink-400">— € {euro(p.prijs)} /mnd, {p.gebruikersInbegrepen} gebruikers</span></label>
          ))}
        </fieldset>
        <label class="grid gap-1 text-sm font-medium">Huidig boekhoudpakket<input name="pakket" placeholder="Bijv. SnelStart, Exact Online, Jortt, AFAS" class="rounded-xl border border-navy-100 px-3 py-2.5" /></label>
        <label class="grid gap-1 text-sm font-medium">Geschat aantal klanten<input name="klanten" type="number" min="1" class="rounded-xl border border-navy-100 px-3 py-2.5" /></label>
        <label class="grid gap-1 text-sm font-medium">Opmerkingen<textarea name="opmerking" rows="4" class="rounded-xl border border-navy-100 px-3 py-2.5"></textarea></label>
        <label class="flex items-start gap-3 text-sm text-ink-600"><input type="checkbox" required class="mt-1 h-4 w-4 accent-navy-800" /> Ik ga akkoord met de <a href="/privacy" class="underline">privacyverklaring</a>. Mijn gegevens worden alleen gebruikt om deze aanvraag af te handelen.</label>
        <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
        <button type="submit" class="btn-primary w-max">Aanvraag versturen</button>
        <p id="melding" class="hidden rounded-lg bg-teal-100 px-4 py-3 text-sm text-teal-600"></p>
      </form>
    </div>
    <aside class="space-y-6">
      <div class="card">
        <p class="eyebrow">Zo gaat het verder</p>
        <ol class="mt-4 space-y-3 text-sm text-ink-600">
          <li><strong class="text-navy-800">1. Kennismaken.</strong> Wij bellen kort om uw wensen en uw huidige pakket door te nemen.</li>
          <li><strong class="text-navy-800">2. Inrichten.</strong> Uw omgeving op <span class="font-mono">uwkantoor.coportaal.nl</span>, met uw logo en gegevens.</li>
          <li><strong class="text-navy-800">3. Importeren.</strong> Uw klanten uit een CSV- of Excel-export van uw pakket.</li>
          <li><strong class="text-navy-800">4. Uitleg.</strong> Een uur samen door het portaal, daarna gaat u live.</li>
        </ol>
      </div>
      <div class="card">
        <p class="eyebrow">Liever eerst praten?</p>
        <p class="mt-3 text-sm text-ink-600">Mail naar <a class="underline" href={`mailto:${SITE.email}`}>{SITE.email}</a> of vraag een inlog op het demokantoor aan via de <a class="underline" href="/demo">demopagina</a>.</p>
      </div>
    </aside>
  </section>

  <script>
    // Voorselectie uit de prijzenpagina (?p=all&g=5)
    const p = new URLSearchParams(location.search);
    const pk = p.get('p');
    if (pk) document.querySelectorAll<HTMLInputElement>('.pak').forEach(r => { r.checked = r.value === pk; });
    const g = p.get('g');
    if (g) (document.querySelector('[name=gebruikers]') as HTMLInputElement).value = g;

    // Verzenden naar het beheer van CoPortaal; lukt dat niet, dan via het e-mailprogramma.
    const AANVRAAG_URL = 'https://assmaihnaojaulhtjkiq.supabase.co/functions/v1/aanvraag';
    const form = document.getElementById('aanvraag') as HTMLFormElement;
    const knop = form.querySelector('button[type=submit]') as HTMLButtonElement;
    form.addEventListener('submit', async e => {
      e.preventDefault();
      const d = new FormData(form);
      const mel = document.getElementById('melding')!;
      const body = {
        kantoor: d.get('kantoor'), kvk: d.get('kvk'), naam: d.get('naam'), email: d.get('email'), telefoon: d.get('telefoon'),
        gebruikers: d.get('gebruikers'), pakket: d.get('pakket_keuze'), boekhoudpakket: d.get('pakket'), klanten: d.get('klanten'),
        opmerking: d.get('opmerking'), website: d.get('website'),
      };
      knop.disabled = true;
      try {
        const r = await fetch(AANVRAAG_URL, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        const j = await r.json().catch(() => ({}));
        if (!r.ok || !j.ok) throw new Error(j.error || 'Verzenden mislukt');
        form.reset();
        mel.textContent = 'Dank u wel. Uw aanvraag is ontvangen; wij nemen dezelfde of de volgende werkdag contact met u op.';
        mel.classList.remove('hidden');
        mel.scrollIntoView({ behavior: 'smooth', block: 'center' });
      } catch {
        const regels = Object.entries(body).filter(([k]) => k !== 'website').map(([k, v]) => `${k}: ${v ?? ''}`);
        location.href = 'mailto:info@coportaal.nl?subject=' + encodeURIComponent('Aanvraag CoPortaal — ' + d.get('kantoor')) + '&body=' + encodeURIComponent(regels.join('
'));
        mel.textContent = 'Direct verzenden lukte niet; uw e-mailprogramma opent met de aanvraag. Verstuur die mail en wij nemen contact op.';
        mel.classList.remove('hidden');
      }
      knop.disabled = false;
    });
  </script>
</Base>
