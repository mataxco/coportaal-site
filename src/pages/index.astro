---
import Base from '../layouts/Base.astro';
import { BASIS, MODULES, SITE } from '../data/site';

const faq = [
  { v: 'Voor wie is CoPortaal?', a: 'Voor administratiekantoren, boekhouders en belastingadviseurs met 1 tot 15 medewerkers die hun klanten, deadlines en taken op één plek willen hebben.' },
  { v: 'Waar staan onze gegevens?', a: 'Elk kantoor krijgt een eigen, afgeschermde omgeving op servers in de EU. Gegevens van kantoren staan nooit bij elkaar in één database.' },
  { v: 'Moeten we ons boekhoudpakket inruilen?', a: 'Nee. CoPortaal regelt het werk eromheen: klantbeheer, workflow, taken, identificatie en facturatie. Klanten importeert u uit elk pakket via CSV; een koppeling met uw pakket is op aanvraag mogelijk.' },
  { v: 'Hoe snel kunnen we beginnen?', a: 'Na uw aanvraag staat uw omgeving binnen één werkdag klaar. Wij importeren uw klanten en lopen het portaal in een uur met u door.' },
  { v: 'Zitten we ergens aan vast?', a: 'Nee. Abonnementen zijn per maand en maandelijks opzegbaar. Modules kunt u per maand aan- of uitzetten.' },
];
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map(f => ({ '@type': 'Question', name: f.v, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base
  title="CoPortaal — CRM en praktijkbeheer voor administratiekantoren"
  description="Klanten, workflow, taken, Wwft-identificatie en facturatie op één plek. Gemaakt door een administratiekantoor, voor kantoren met 1 tot 15 medewerkers. Eigen omgeving per kantoor, maandelijks opzegbaar."
  pad="/"
  schema={[faqSchema]}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-navy-950 text-white">
    <div class="pointer-events-none absolute inset-0 opacity-30" style="background: radial-gradient(60% 50% at 70% 20%, #2F55A4 0%, transparent 70%);"></div>
    <div class="container-x relative grid items-center gap-12 py-20 md:grid-cols-2 md:py-28">
      <div>
        <p class="eyebrow text-gold-500">Praktijkbeheer voor kantoren</p>
        <h1 class="mt-4 text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl">
          Alles van uw kantoor in één portaal. <span class="text-gold-500">Zonder losse lijstjes.</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg text-navy-100">
          Klanten, deadlines, taken, identificatie en facturatie: wat nu verspreid staat over Excel, mail en mappen, ziet u met CoPortaal in één oogopslag. Gebouwd door een administratiekantoor dat er zelf elke dag mee werkt.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/demo" class="btn bg-gold-500 text-navy-950 hover:bg-gold-600">Bekijk de demo</a>
          <a href="/prijzen" class="btn border border-white/25 text-white hover:bg-white/10">Stel uw abonnement samen</a>
        </div>
        <p class="mt-6 text-sm text-navy-100/80">Vanaf € {BASIS.prijs} per maand · eigen omgeving per kantoor · maandelijks opzegbaar</p>
      </div>
      <div class="card border-white/10 bg-white/5 p-3 shadow-none backdrop-blur">
        <!-- Plaatshouder voor de hoofdvideo (90 sec) -->
        <div class="flex aspect-video items-center justify-center rounded-xl bg-navy-900 text-navy-100">
          <div class="text-center">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-gold-500 text-navy-950">▶</div>
            <p class="mt-3 text-sm">Video: CoPortaal in 90 seconden</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Herkenning -->
  <section class="container-x py-16">
    <p class="eyebrow">Herkent u dit?</p>
    <div class="mt-4 grid gap-6 md:grid-cols-3">
      {[
        ['Welke IB-aangiften staan nog open?', 'Het antwoord zit in drie Excel-bestanden en het hoofd van één collega.'],
        ['Is die klant al geïdentificeerd?', 'Ergens staat een kopie van een paspoort. Of het de goede is en wanneer, weet niemand zeker.'],
        ['Wie moet nog betalen?', 'De debiteurenlijst komt uit het boekhoudpakket, de herinneringen gaan handmatig, en soms blijft er iets liggen.'],
      ].map(([k, t]) => (
        <div class="card">
          <h3 class="font-semibold text-navy-800">{k}</h3>
          <p class="mt-2 text-sm text-ink-600">{t}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Basis -->
  <section class="bg-navy-50 py-16">
    <div class="container-x grid items-start gap-10 md:grid-cols-2">
      <div>
        <p class="eyebrow">De basis</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-navy-900">{BASIS.kop}</h2>
        <p class="mt-4 text-ink-600">Het portaal vervangt de losse lijstjes. Elke klant heeft één kaart met zijn gegevens, aangiften, taken en documenten. Elke medewerker ziet wat vandaag van hem wordt verwacht. En u ziet in één dashboard waar het kantoor staat.</p>
        <a href="/modules" class="btn-secondary mt-6">Bekijk alle onderdelen</a>
      </div>
      <ul class="grid gap-3">
        {BASIS.punten.map(p => (
          <li class="flex items-start gap-3 rounded-xl bg-white p-4 text-sm shadow-sm">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-teal-100 text-teal-600">✓</span>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Modules -->
  <section class="container-x py-16">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Modules</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-navy-900">Begin met de basis. Zet erbij wat u nodig heeft.</h2>
      </div>
      <a href="/prijzen" class="btn-secondary">Naar de prijzen</a>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {MODULES.map(m => (
        <a href={`/modules/${m.slug}`} class="card group transition hover:-translate-y-0.5 hover:border-navy-600/40">
          <div class="flex items-center justify-between">
            <h3 class="text-xl font-semibold text-navy-800">{m.naam}</h3>
            <span class="rounded-full bg-navy-50 px-2.5 py-1 text-xs font-semibold text-navy-700">+ € {m.prijs}/mnd</span>
          </div>
          <p class="mt-3 text-sm text-ink-600">{m.kop}</p>
          <p class="mt-4 text-sm font-medium text-navy-600 group-hover:underline">Lees meer →</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Waarom -->
  <section class="bg-navy-900 py-16 text-white">
    <div class="container-x grid gap-8 md:grid-cols-3">
      {[
        ['Door een kantoor, voor kantoren', 'CoPortaal is ontstaan op de werkvloer van een administratie- en belastingadvieskantoor. Elke functie is er omdat iemand hem nodig had, niet omdat hij goed klonk in een verkooppraatje.'],
        ['Uw eigen omgeving', 'Geen gedeelde database met andere kantoren. Uw klantgegevens staan in uw eigen omgeving in de EU, met dagelijkse back-ups en herstel tot op de minuut.'],
        ['Geen verrassingen', 'Eén maandprijs per kantoor. Modules zet u aan of uit wanneer u wilt. Opzeggen kan per maand.'],
      ].map(([k, t]) => (
        <div>
          <h3 class="text-lg font-semibold text-gold-500">{k}</h3>
          <p class="mt-2 text-sm text-navy-100">{t}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="container-x py-16">
    <p class="eyebrow">Veelgestelde vragen</p>
    <div class="mt-6 grid gap-4 md:grid-cols-2">
      {faq.map(f => (
        <details class="card group">
          <summary class="cursor-pointer list-none font-semibold text-navy-800">{f.v}</summary>
          <p class="mt-3 text-sm text-ink-600">{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="container-x pb-8">
    <div class="rounded-3xl bg-gradient-to-br from-navy-800 to-navy-600 p-10 text-center text-white">
      <h2 class="text-3xl font-bold tracking-tight">Binnen één werkdag uw eigen portaal</h2>
      <p class="mx-auto mt-3 max-w-xl text-navy-100">Kies uw modules, doe de aanvraag en wij richten alles in. Liever eerst kijken? Vraag een inlog op het demokantoor aan.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/aanvraag" class="btn bg-gold-500 text-navy-950 hover:bg-gold-600">Aanvraag doen</a>
        <a href={`mailto:${SITE.email}`} class="btn border border-white/25 text-white hover:bg-white/10">Of mail ons</a>
      </div>
    </div>
  </section>
</Base>
