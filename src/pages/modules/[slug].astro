---
import Base from '../../layouts/Base.astro';
import { MODULES } from '../../data/site';

export function getStaticPaths() {
  return MODULES.map(m => ({ params: { slug: m.slug }, props: { m } }));
}
const { m } = Astro.props;
const meta: Record<string, { title: string; description: string }> = {
  kyc: { title: 'KYC en Wwft-identificatie voor accountantskantoren — CoPortaal', description: 'Laat klanten zich identificeren op hun telefoon: ID-scan, selfie, automatische BSN-afscherming, herinneringen en hercontrole. Een compleet Wwft-dossier per klant.' },
  facturatie: { title: 'Facturatie, incasso en debiteurenbeheer voor kantoren — CoPortaal', description: 'Facturen en offertes, periodieke facturatie, SEPA-incasso via Mollie en een debiteurenproces met aanmaning en 14-dagenbrief. Dubieuze debiteuren in één lijst.' },
  loon: { title: 'Loonverwerking in één overzicht — CoPortaal', description: 'Per werkgever zien of uren, verloning, aangifte en verzending zijn gedaan. Loonheffingsverklaringen en arbeidsovereenkomsten digitaal laten ondertekenen.' },
};
---
<Base title={meta[m.slug].title} description={meta[m.slug].description} pad={`/modules/${m.slug}`}>
  <section class="bg-navy-50 py-16">
    <div class="container-x grid items-center gap-10 md:grid-cols-2">
      <div>
        <p class="eyebrow">Module</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-navy-900">{m.naam}</h1>
        <p class="mt-3 text-xl font-medium text-navy-700">{m.kop}</p>
        <p class="mt-4 text-ink-600">{m.intro}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href={`/prijzen?p=${m.slug === 'kyc' ? 'all' : 'compleet'}`} class="btn-primary">Inbegrepen in {m.inbegrepenIn} · bekijk prijzen</a>
          <a href="/demo" class="btn-secondary">Bekijk de demo</a>
        </div>
      </div>
      <div class="card p-3">
        <div class="flex aspect-video items-center justify-center rounded-xl bg-navy-900 text-navy-100">
          <div class="text-center">
            <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-gold-500 text-navy-950">▶</div>
            <p class="mt-3 text-sm">Video: {m.naam} in 2 minuten</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="container-x grid gap-10 py-16 md:grid-cols-[2fr_1fr]">
    <div>
      <h2 class="text-2xl font-semibold text-navy-900">Wat zit erin</h2>
      <ul class="mt-5 grid gap-3">
        {m.punten.map(p => (
          <li class="flex items-start gap-3 rounded-xl border border-navy-100 p-4 text-sm">
            <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-teal-100 text-teal-600">✓</span><span>{p}</span>
          </li>
        ))}
      </ul>
    </div>
    <aside class="card h-max">
      <p class="eyebrow">Het probleem dat het oplost</p>
      <p class="mt-3 text-sm text-ink-600">{m.probleem}</p>
      <p class="mt-6 text-xs text-ink-400">Prijzen zijn per kantoor per maand, exclusief btw. Maandelijks opzegbaar.</p>
    </aside>
  </section>
</Base>
