---
import Base from '../layouts/Base.astro';
import { BASIS, INRICHTING, MODULES, PAKKETTEN, PRIJS_EXTRA_GEBRUIKER, euro } from '../data/site';
const config = { extra: PRIJS_EXTRA_GEBRUIKER, pakketten: Object.fromEntries(PAKKETTEN.map(p => [p.slug, { prijs: p.prijs, incl: p.gebruikersInbegrepen, naam: p.naam }])) };
---
<Base
  title="Prijzen — twee pakketten, één maandprijs — CoPortaal"
  description="CoPortaal Compleet € 150 per maand (3 gebruikers) of CoPortaal ALL met KYC € 199,95 per maand (5 gebruikers). Extra gebruiker € 12,50. Per kantoor, maandelijks opzegbaar, exclusief btw."
  pad="/prijzen"
>
  <section class="container-x py-16">
    <p class="eyebrow">Prijzen</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-navy-900">Twee pakketten, één maandprijs</h1>
    <p class="mt-4 max-w-2xl text-ink-600">Kies het pakket en geef op met hoeveel mensen u werkt. Dat is de hele rekensom. Alles exclusief btw, maandelijks opzegbaar.</p>

    <div class="mt-10 grid gap-8 lg:grid-cols-[3fr_2fr]" id="configurator">
      <div class="space-y-8">
        <div>
          <p class="text-sm font-semibold text-ink-400">Stap 1 · Pakket</p>
          <div class="mt-3 grid gap-4 md:grid-cols-2">
            {PAKKETTEN.map(p => (
              <label class="relative flex cursor-pointer flex-col rounded-2xl border-2 border-navy-100 bg-white p-5 has-[:checked]:border-navy-600 has-[:checked]:bg-navy-50/60">
                {p.aanbevolen && <span class="absolute -top-3 right-4 rounded-full bg-gold-500 px-3 py-0.5 text-xs font-semibold text-navy-950">Meest gekozen</span>}
                <span class="flex items-start gap-3">
                  <input type="radio" name="pakket" class="pak mt-1 h-4 w-4 accent-navy-800" value={p.slug} checked={p.aanbevolen} />
                  <span>
                    <span class="block text-lg font-semibold text-navy-800">{p.naam}</span>
                    <span class="block text-sm text-ink-600">{p.kop}</span>
                  </span>
                </span>
                <span class="mt-4 text-2xl font-bold text-navy-900">€ {euro(p.prijs)}<span class="text-xs font-medium text-ink-400"> /mnd · {p.gebruikersInbegrepen} gebruikers</span></span>
                <ul class="mt-3 space-y-1 text-sm text-ink-600">
                  <li class="flex gap-2"><span class="text-teal-600">✓</span>{BASIS.naam}: klanten, workflow, taken, team, kennisbank, documenten, ondertekenen</li>
                  {MODULES.map(m => (
                    <li class={`flex gap-2 ${p.modules.includes(m.slug) ? '' : 'text-ink-400 line-through'}`}><span class={p.modules.includes(m.slug) ? 'text-teal-600' : 'text-ink-400'}>{p.modules.includes(m.slug) ? '✓' : '–'}</span>{m.naam}: {m.kop}</li>
                  ))}
                </ul>
              </label>
            ))}
          </div>
        </div>

        <div>
          <p class="text-sm font-semibold text-ink-400">Stap 2 · Gebruikers</p>
          <div class="mt-3 flex items-center gap-4 rounded-2xl border border-navy-100 bg-white p-5">
            <input type="range" id="gebr" min="1" max="25" value="5" class="flex-1 accent-navy-800" />
            <span id="gebr-out" class="min-w-[12rem] text-sm font-medium text-navy-800"></span>
          </div>
          <p class="mt-2 text-xs text-ink-400">Elke gebruiker boven het inbegrepen aantal: € {euro(PRIJS_EXTRA_GEBRUIKER)} per maand. Meekijken zonder te werken is gratis.</p>
        </div>
      </div>

      <aside class="card sticky top-24 h-max bg-navy-50/60">
        <p class="text-sm font-semibold text-ink-400">Uw abonnement</p>
        <p class="mt-1 text-lg font-semibold text-navy-800" id="pak-naam"></p>
        <p class="text-4xl font-bold text-navy-900" id="totaal"></p>
        <p class="text-sm text-ink-600">per maand, exclusief btw · maandelijks opzegbaar</p>
        <p class="mt-3 hidden rounded-lg bg-teal-100 px-3 py-2 text-sm text-teal-600" id="all-tip"></p>
        <div class="mt-5 border-t border-navy-100 pt-4 text-sm text-ink-600">
          <p><strong class="text-navy-800">Eenmalig € {INRICHTING.prijs}</strong> — {INRICHTING.omschrijving}</p>
        </div>
        <a href="/aanvraag" id="aanvraag-link" class="btn-primary mt-6 w-full">Aanvraag doen</a>
        <p class="mt-3 text-xs text-ink-400">Binnen één werkdag staat uw omgeving klaar. Geen betaalgegevens nodig voor de aanvraag.</p>
      </aside>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {[
        ['Alles inbegrepen', 'Hosting in de EU, dagelijkse back-ups, updates, e-mailverkeer vanuit het portaal en support per e-mail.'],
        ['Geen gebruikerslimiet op lezen', 'Een collega die alleen hoeft mee te kijken telt niet als gebruiker. U betaalt voor wie werkt in het portaal.'],
        ['Zelf wisselen', 'Van Compleet naar ALL? Eén mail en KYC staat dezelfde dag aan. Terug kan per maand.'],
      ].map(([k, t]) => <div class="card"><h3 class="font-semibold text-navy-800">{k}</h3><p class="mt-2 text-sm text-ink-600">{t}</p></div>)}
    </div>
  </section>

  <script define:vars={{ config }}>
    const paks = [...document.querySelectorAll('.pak')];
    const gebr = document.getElementById('gebr');
    const uit = document.getElementById('gebr-out');
    const tot = document.getElementById('totaal');
    const naam = document.getElementById('pak-naam');
    const tip = document.getElementById('all-tip');
    const link = document.getElementById('aanvraag-link');
    const euro = n => '€ ' + (Number.isInteger(n) ? n : n.toFixed(2).replace('.', ','));
    // Keuze uit de URL (bv. vanaf een modulepagina): ?p=all
    const vooraf = new URLSearchParams(location.search).get('p');
    if (vooraf) paks.forEach(r => { r.checked = r.value === vooraf; });
    function herbereken() {
      const slug = (paks.find(r => r.checked) || paks[0]).value;
      const pak = config.pakketten[slug];
      const g = Number(gebr.value);
      const extra = Math.max(0, g - pak.incl);
      const totaal = pak.prijs + extra * config.extra;
      naam.textContent = pak.naam;
      uit.textContent = g + (g === 1 ? ' gebruiker' : ' gebruikers') + (extra ? ' (+' + extra + ' × ' + euro(config.extra) + ')' : ' (inbegrepen)');
      tot.textContent = euro(Math.round(totaal * 100) / 100);
      // Bij Compleet met 5+ gebruikers is ALL bijna even duur en zit KYC erbij
      const all = config.pakketten.all;
      const allTotaal = all.prijs + Math.max(0, g - all.incl) * config.extra;
      const toonTip = slug !== 'all' && allTotaal - totaal <= 30;
      tip.classList.toggle('hidden', !toonTip);
      tip.textContent = toonTip ? 'Voor ' + euro(Math.round((allTotaal - totaal) * 100) / 100) + ' per maand meer heeft u CoPortaal ALL, met KYC en 5 gebruikers inbegrepen.' : '';
      link.href = '/aanvraag?p=' + slug + '&g=' + g;
    }
    paks.forEach(r => r.addEventListener('change', herbereken));
    gebr.addEventListener('input', herbereken);
    herbereken();
  </script>
</Base>
